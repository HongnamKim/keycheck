# 이 파일을 .env로 복사해 값을 넣는다. .env는 커밋하지 않는다.
ANTHROPIC_API_KEY=sk-ant-...
# 실제 요약기를 쓰려면 claude (기본 fake)
# SUMMARIZER=claude
# 모델은 기본 claude-sonnet-5-5. 바꿀 때만 쓴다. 이 파일은 설정 파일로 읽으므로 점 표기로 쓴다
# (KEYCHECK_CLAUDE_MODEL 같은 대문자 표기는 실제 환경변수일 때만 통한다)
# keycheck.claude.model=claude-haiku-5-5
# 이미지 축소본 저장소(Cloudflare R2). 쓰려면 주석을 풀고 값을 넣는다. 비어 있으면 축소본을 만들지 않고 화면은 원본 이미지를 쓴다
# R2_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
# R2_BUCKET=<버킷 이름>
# R2_ACCESS_KEY_ID=<R2 API 토큰의 Access Key ID>
# R2_SECRET_ACCESS_KEY=<R2 API 토큰의 Secret Access Key>
# 로컬은 버킷의 r2.dev 공개 주소, 배포는 연결한 도메인
# R2_PUBLIC_URL=https://pub-<...>.r2.dev
# 디스코드 판매 공지 수집. 쓰려면 주석을 풀고 값을 넣는다. 봇 토큰은 비밀값이라 커밋하지 않는다
# DISCORD_BOT_TOKEN=
# SWAGKEY_CHANNEL_ID=
# GEONWORKS_CHANNEL_ID=
# 수집·보관 작업을 켠다 (기본 끔)
# NOTICE_ENABLED=true
# 공지 요약 작업을 켠다. Claude 요약 비용이 드니 샘플을 확인한 뒤에만 (기본 끔)
# NOTICE_SUMMARY_ENABLED=true
# 운영 항목. 바꿀 때만 쓴다. 운영 서버는 이 파일을 두지 않고 실제 환경변수로 넣는다
# API 문서와 Swagger UI (운영 false)
# SPRINGDOC_ENABLED=false
# DB 연결 풀 크기 (기본 10, 운영 5)
# DB_POOL_SIZE=5
# 브라우저에서 백엔드를 부를 수 있는 프론트 주소. 쉼표로 여러 개, 끝에 / 없이
# KEYCHECK_CORS_ALLOWED_ORIGINS=http://localhost:3000
