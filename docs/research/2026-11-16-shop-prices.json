    "how_to_read": [
      "offers 한 원소 = 한 몰의 한 상품(옵션 묶음). spring_matrix는 스프링을 몰 x 길이(mm) x 키압(g) 칸으로 펼친 것이다.",
      "price_status: verified = 몰 페이지에서 직접 읽음, index = 검색 엔진 색인 문구에서 읽어 확인 전(옛 가격일 수 있음), missing = 가격을 못 찾음.",
      "geonworks.kr은 스프링·윤활제를 팔지 않는다(검색 '스프링', '윤활', '크라이톡스', 'spring', 'lube' 결과 없음). 체리 스위치만 있다.",
      "스웨그키·TX 값은 사용자가 몰에서 확인해 문서 '스프링 행렬(입력)' 탭과 본문 표에 고친다. 고친 값을 읽어 price_status를 verified로 바꾼다."
    ],
    "fields": {
      "shop": "geonworks | swagkey | tx (meta.shops 참고)",
      "category": "switch | spring | lubricant",
      "spec": "switch: series, axis_kr, type, pins, rgb, force_g / spring: length_mm, length_approx, force_options_g(목록 또는 문구), force_basis(bottom_out), stages / lubricant: product_line, form",
      "pack_qty": "묶음 개수. 모르면 null",
      "volume": "윤활제 용량 {value, unit}",
      "price_krw": "표시 판매가(원). 모르면 null",
      "unit_price_krw": "price_krw / pack_qty 또는 / volume.value, 반올림",
      "price_status": "verified | index | missing",
      "sold_out": "품절 표기 여부. 모르면 null",
      "min_order": "최소 주문 수량. 모르면 null",
      "url": "상품 페이지(색인 값은 색인에 잡힌 주소)",
      "checked_at": "조사일"
    },
    "manual_input": {
      "where": "문서 '스프링 행렬(입력)' 탭 https://claude.ai/artifact/8dG4Qa2BypQtdXEndGwe1W#a7206253-8ccb (doc 3dc006d0-106e-47d9-8c69-aebdaf56f4f1, 본문 node 32412d80-bb6d)",
      "mapping": "몰마다 표 하나: 행 = 길이(mm), 열 = 키압(g), 칸 = 110개 가격(원). 빈 칸 = 그 몰에 없음, '?' = 판매하지만 가격 미확인. 숫자를 쓰면 그 칸의 price_krw, 표 위 '수량' 줄이 pack_qty. 사용자가 쓴 값은 price_status=verified."
    }
