# 운영 서버의 백엔드 환경변수. 서버의 /etc/keycheck/keycheck.env(root 소유, 600)에 붙여 넣고 <...>를 채운다.
# 이 예시에는 비밀값을 넣지 않는다. 비밀값은 셸 명령(echo 등)이 아니라 서버의 편집기로 직접 넣는다.
# 형식: 한 줄에 이름=값. compose가 값을 적은 그대로 넘긴다($·#·따옴표·줄 끝 공백도 값에 들어간다).
# 그래서 값에 따옴표를 두르지 않고, 주석은 줄 끝이 아닌 따로 된 줄에 쓴다.
# 바꾼 뒤에는 /opt/keycheck에서 sudo docker compose up -d --force-recreate app

# DB: Supabase 세션 풀러(5432). 호스트는 대시보드 Connect 창에서 그대로 복사한다. 트랜잭션 풀러(6543)는 쓰지 않는다
DB_URL=jdbc:postgresql://<세션 풀러 호스트>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<Supabase DB 비밀번호>
# 세션 풀러는 연결 수가 적다
DB_POOL_SIZE=5

# 브라우저에서 백엔드를 부르는 프론트 주소(끝에 / 없이). www는 Vercel이 keycheck.kr로 넘긴다
KEYCHECK_CORS_ALLOWED_ORIGINS=https://keycheck.kr

# 요약기. 빠뜨리면 가짜 요약기로 떠 IC 글에 가짜 요약이 남으므로 첫 기동부터 claude
SUMMARIZER=claude
# Anthropic 운영 전용 워크스페이스의 키(월 지출 한도를 건 워크스페이스)
ANTHROPIC_API_KEY=<운영 전용 키>

# 수집과 축소본. 미리 읽기는 운영해 본 뒤 정한다(켜면 2020년 이후 틀 글을 모두 채워 요약)
CRAWL_ENABLED=true
THUMBNAIL_ENABLED=true
PREFETCH_ENABLED=false

# 축소본 저장소: R2 운영 전용 버킷과 그 버킷만 Object Read & Write 할 수 있는 토큰
R2_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
R2_BUCKET=<운영 버킷 이름>
R2_ACCESS_KEY_ID=<운영 토큰 Access Key ID>
R2_SECRET_ACCESS_KEY=<운영 토큰 Secret Access Key>
R2_PUBLIC_URL=https://img.keycheck.kr

# 디스코드 판매 공지: 봇 토큰(비밀값)과 판매처 채널 id. 수집·보관과 요약 작업을 켠다
DISCORD_BOT_TOKEN=
SWAGKEY_CHANNEL_ID=
GEONWORKS_CHANNEL_ID=
NOTICE_ENABLED=true
NOTICE_SUMMARY_ENABLED=true

# API 문서와 Swagger UI를 끈다
SPRINGDOC_ENABLED=false

# 비용·악용 상한. 아래는 기본값과 같으므로 바꿀 때만 주석을 푼다
# 하루(한국 시간) Claude 요약 상한
# KEYCHECK_SUMMARY_DAILYLIMIT=2000
# 동시에 요약하는 geekhack 글 수
# KEYCHECK_SUMMARY_CONCURRENCY=2
# 틀 글 채우기 동시 상한, 채우기에 실패한 글을 다시 요청하지 않는 시간
# KEYCHECK_FILL_MAXCONCURRENT=3
# KEYCHECK_FILL_FAILURECOOLDOWN=10m
# 조회수 갱신이 한 시간에 geekhack에 요청하는 상한, 마지막 댓글이 오래된 글의 기준과 그 글의 갱신 간격
# KEYCHECK_STATS_HOURLYBUDGET=60
# KEYCHECK_STATS_INACTIVEAFTER=30d
# KEYCHECK_STATS_INACTIVEINTERVAL=24h
